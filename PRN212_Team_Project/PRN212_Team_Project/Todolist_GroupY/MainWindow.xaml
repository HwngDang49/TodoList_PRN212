<Window x:Class="Todolist_GroupY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todolist_GroupY"
        mc:Ignorable="d"
        Title="TodoList - Notes" Height="600" Width="820" WindowStartupLocation="CenterScreen" Background="#B2DAE4" Loaded="Window_Loaded">
    <DockPanel LastChildFill="True">
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12" Background="#B2DAE4" BorderBrush="#E4E6EB" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Title + Today -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Label Content="Todo App" FontSize="18" FontWeight="Bold" Margin="0,0,8,0"/>
                    <Label Content="|" Margin="8,0,8,0"/>
                    <Label Content="Hôm nay:" Margin="0,0,4,0"/>
                    <Label x:Name="TodayLabel" Content="{Binding TodayText}" />
                </StackPanel>

                <!-- spacer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"/>

                <!-- Filters (DatePicker + CheckBox) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <DatePicker x:Name="FilterDatePicker" Width="150"  Margin="0,0,10,0" SelectedDateChanged="FilterDatePicker_SelectedDateChanged"/>
                    <CheckBox x:Name="ShowCompletedCheckBox" Content="Hiện đã hoàn thành" Checked="ShowCompletedCheckBox_Checked" Unchecked="ShowCompletedCheckBox_Unchecked"/>

                </StackPanel>

                <!-- Search -->
                <DockPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBox x:Name="SearchTextBox" Height="30" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <!-- Actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="Thêm" x:Name="CreateButton"  Padding="12,6" Margin="0,0,6,0" Background="#FF9E9E" Foreground="#FFFFFF" Width="60" Click="CreateButton_Click"/>
                    <Button Content="Sửa" x:Name="UpdateButton" Padding="12,6" Margin="0,0,6,0" Background="#FA7305" Foreground="#FFFFFF" Width="62" Click="UpdateButton_Click"/>
                    <Button Content="Xóa" x:Name="DeleteButton"  Padding="12,6" Margin="0,0,6,0" Background="#FF0000" Foreground="#FFFFFF" Width="60" Click="DeleteButton_Click"/>
                    <Button Content="Chi Tiết" x:Name="ViewDetailButton"  Padding="12,6" Background="#30BE71" Foreground="#FFFFFF" RenderTransformOrigin="0.799,0.624" Width="75" Click="ViewDetailButton_Click_1"/>
                </StackPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="TodoDataGrid" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tiêu đề" Width="350" Binding="{Binding Title}" />
                        <DataGridTextColumn Header="Hạn" Width="170" Binding="{Binding DueDate}" />
                        <DataGridTextColumn Header="Nhắc" Width="170" Binding="{Binding ReminderTime}" />
                        <DataGridTextColumn Header="Xong" Width="100" Binding="{Binding IsCompleted}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>