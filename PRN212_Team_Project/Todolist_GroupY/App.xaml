<Application x:Class="Todolist_GroupY.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Todolist_GroupY"
              xmlns:tb="http://www.hardcodet.net/taskbar"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <!-- Tray Icon -->
        <tb:TaskbarIcon x:Key="NotifyIcon"
                 IconSource="icon.ico"
                 ToolTipText="TodoList Application"
                 TrayMouseDoubleClick="NotifyIcon_TrayMouseDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open TodoList" Click="MenuItem_Open_Click" FontWeight="Bold"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="MenuItem_Exit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
