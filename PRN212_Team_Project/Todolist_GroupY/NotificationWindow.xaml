<Window x:Class="Todolist_GroupY.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification" 
        Height="120" Width="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        Icon="/Assets/icon.ico">

    <Border Background="White" 
            CornerRadius="8" 
            BorderThickness="1" 
            BorderBrush="#E0E0E0"
            Padding="15">
        <Border.Effect>
            <DropShadowEffect Color="Black" 
                            Opacity="0.2" 
                            BlurRadius="10" 
                            ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon từ file icon.ico -->
            <Image Grid.Column="0" 
                   Source="/Assets/icon.ico" 
                   Width="40" Height="40" 
                   Margin="0,0,10,0"/>

            <!-- Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock 
                          FontWeight="SemiBold" 
                          FontSize="12"
                          Foreground="#666"><Run Text="⏰ Nhắc nhở"/><LineBreak/><Run/></TextBlock>
                <TextBlock x:Name="TaskTitleText" 
    Text="Task Title" 
    FontSize="14"
    FontWeight="Medium"
    Margin="0,3,0,0"
    TextTrimming="CharacterEllipsis" 
    Height="49"
    Foreground="#333333"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Column="2" 
                       Orientation="Horizontal" 
                       VerticalAlignment="Center"
                       Margin="10,0,0,0">
                <Button x:Name="SnoozeButton" 
                       Content="Snooze" 
                       Width="70" Height="30"
                       Margin="0,0,5,0"
                       Click="SnoozeButton_Click"
                       Style="{StaticResource NotificationButtonStyle}"/>
                <Button x:Name="CompleteButton" 
                       Content="Complete" 
                       Width="80" Height="30"
                       Click="CompleteButton_Click"
                       />
            </StackPanel>
        </Grid>
    </Border>
</Window>