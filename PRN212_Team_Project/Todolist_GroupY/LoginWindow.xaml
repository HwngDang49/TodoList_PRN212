<Window x:Class="Todolist_GroupY.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Todolist_GroupY"
        mc:Ignorable="d"
Title="Login" Height="320" Width="420" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#B2DAE4">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Welcome" FontSize="20" FontWeight="Bold" Foreground="#252525" FontFamily="Nunito"/>

        <StackPanel Grid.Row="2">
            <Label Content="Email" Margin="0,0,0,4" Foreground="#252525" FontFamily="Nunito"/>
            <TextBox x:Name="EmailTextBox" Height="32" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <Label Content="Password" Margin="0,0,0,4" Foreground="#252525" FontFamily="Nunito"/>
            <PasswordBox x:Name="PasswordBox" Height="32" />
        </StackPanel>

        <CheckBox x:Name="RememberCheckBox" Grid.Row="6" Content="Remember me" Foreground="#252525" FontFamily="Nunito"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LoginButton" Content="Login" Width="100" Height="32"  Background="#FA7305" Foreground="#FFFFFF" Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
