<Window
    x:Class="Todolist_GroupY.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Todolist_GroupY"
    mc:Ignorable="d"
    Title="Login"
    Height="700"
    Width="500"
    WindowStartupLocation="CenterScreen"
    ResizeMode="NoResize"
    FontFamily="Cascadia Mono"
    Background="#f5f4f2">
    <Grid
        Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="60" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition 
                Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            VerticalAlignment="Center">
            <Image
                Source="/Assets/Logo.png"
                Width="40"
                Height="50" />
            <TextBlock
                VerticalAlignment="Center"
                Margin="8,0,0,0"
                LineStackingStrategy="BlockLineHeight"
                LineHeight="16"
                FontSize="18"
                FontWeight="Bold">
                Todo's
                <LineBreak />
                App
            </TextBlock>

        </StackPanel>

        <TextBlock
            Grid.Row="1"
            Text="Get your job done IN TIME"
            TextWrapping="Wrap"
            Margin="0,25,0,0"
            FontSize="40"
            FontWeight="SemiBold" />

        <StackPanel
            Grid.Row="2"
            Margin="0,100,0,0">
            <StackPanel>
                <TextBlock
                    Text="Email"
                    Style="{StaticResource LabelStyle}" />
                <TextBox
                    x:Name="EmailTextBox"
                    Height="40"
                    Style="{StaticResource TextBoxStyle}" />

                <TextBlock
                    Text="Password"
                    Margin="0,20,0,0"
                    Style="{StaticResource LabelStyle}" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Height="40"
                    Style="{StaticResource PasswordBoxStyle}" />

                <Button
                    x:Name="LoginButton"
                    Content="-> Let's Go"
                    Margin="0,20,0,0"
                    Height="40"
                    Style="{StaticResource Button}"
                    Click="LoginButton_Click" />

                <Button
                    x:Name="RegisterButton"
                    Content="Don't have account ?"
                    Background="Transparent"
                    Margin="0,10,0,0"
                    BorderThickness="0"
                    Width="150">
                </Button>
            </StackPanel>
        </StackPanel>

        <!--<Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Welcome" FontSize="20" FontWeight="Bold" Foreground="#252525" FontFamily="Nunito"/>

        <StackPanel Grid.Row="2">
            <Label Content="Email" Margin="0,0,0,4" Foreground="#252525" FontFamily="Nunito"/>
            <TextBox x:Name="EmailTextBox" Height="32" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <Label Content="Password" Margin="0,0,0,4" Foreground="#252525" FontFamily="Nunito"/>
            <PasswordBox x:Name="PasswordBox" Height="32" />
        </StackPanel>

        <CheckBox x:Name="RememberCheckBox" Grid.Row="6" Content="Remember me" Foreground="#252525" FontFamily="Nunito" Checked="RememberCheckBox_Checked"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="LoginButton" Content="Login" Width="100" Height="32"  Background="#FA7305" Foreground="#FFFFFF" Click="LoginButton_Click"/>
            <Button x:Name="RegisterButton" Content="Register" Width="100" Height="32" Background="#30BE71" Foreground="#FFFFFF" Click="RegisterButton_Click" Margin="8,0,0,0"/>

        </StackPanel>-->
    </Grid>
</Window>
